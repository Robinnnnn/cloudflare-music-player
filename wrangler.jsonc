{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudflare-music-player",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "r2_buckets": [
    {
      "binding": "AUDIO",
      "bucket_name": "cloudflare-music-audio"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
